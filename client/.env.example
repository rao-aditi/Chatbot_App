# Chat server URL the dashboard connects to (browser-visible)
VITE_SERVER_URL=http://localhost:5002

# Server-side only (NOT VITE_-prefixed, never sent to the browser).
# Must equal ADMIN_DASHBOARD_KEY on the chat server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_DASHBOARD_KEY=
# Optional: chat server URL for server-side calls (defaults to VITE_SERVER_URL)
# ADMIN_API_URL=
